<Window x:Class="Lab9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная 9 — освещение и текстурирование"
        Width="1120" Height="820" MinWidth="800" MinHeight="600"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F1F3F5">
            <StackPanel Margin="14">
                <TextBlock Text="Модель" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ComboBox x:Name="ModelBox" SelectedIndex="0" SelectionChanged="Model_Changed">
                    <ComboBoxItem Content="Куб" />
                    <ComboBoxItem Content="Тетраэдр" />
                    <ComboBoxItem Content="Октаэдр" />
                </ComboBox>
                <TextBlock Text="Режим отрисовки" FontWeight="SemiBold" Margin="0,12,0,5" />
                <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="Settings_Changed">
                    <ComboBoxItem Content="Гуро — модель Ламберта" />
                    <ComboBoxItem Content="Фонг — туншейдинг" />
                    <ComboBoxItem Content="Текстурирование" />
                </ComboBox>
                <Button Content="Загрузить текстуру…" Click="LoadTexture_Click" Margin="0,10,0,0" Padding="6" />
                <TextBlock x:Name="TextureName" Text="Встроенная шахматная текстура"
                           TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                <StackPanel x:Name="ParameterPanel" />
                <Button Content="Сбросить параметры" Click="Reset_Click" Margin="0,12,0,0" Padding="6" />
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="ViewportHost" Grid.Column="1" Background="#1A1E24" ClipToBounds="True" SizeChanged="Viewport_SizeChanged">
            <Image x:Name="Viewport" Stretch="Fill" />
        </Border>
    </Grid>
</Window>
